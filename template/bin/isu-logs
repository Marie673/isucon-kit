#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///
from isu_runtime import Kit
import argparse
import re
p = argparse.ArgumentParser()
p.add_argument('action', choices=['on', 'off'])
a = p.parse_args(); k = Kit(); k.canonical()
f = k.root / 'hosts' / k.get('ISU_NGINX_HOST') / 'etc/nginx/conf.d/isu-log.conf'
value = 'off' if a.action == 'off' else k.get('ISU_ACCESS_LOG') + ' isu_json'
f.write_text(re.sub(r'^access_log .*;', 'access_log ' + value + ';', f.read_text(), flags=re.M))
print('変更したパスをコミットして isu-deploy で反映してください。')
print('off の最終ベンチは start --no-deploy --no-measure を使います。')
