# isu.env — 競技環境の定義。全スクリプト（bin/isu-*）がこれを読む。
# コミットして全 worktree で共有する（IP は秘密情報ではない。レポは private）。
# bash 3.2 互換で書くこと（連想配列は使わない）。

# ---------- サーバ ----------
ISU_HOSTS="isu1 isu2 isu3"
ISU_IP_isu1=""
ISU_IP_isu2=""
ISU_IP_isu3=""

# 競技用 SSH（setup 後は isucon ユーザーで入る）
ISU_SSH_USER=isucon
ISU_SSH_KEY="$HOME/.ssh/isucon_ed25519"
# 初回だけ使う入口（EC2 のキーペアで ubuntu 等に入り、isucon に鍵を配る）
ISU_BOOT_USER=ubuntu
ISU_BOOT_KEY="$HOME/.ssh/isucon-aws.pem"
# isucon の authorized_keys に追加する GitHub ユーザー（チーム全員）
ISU_TEAM_GITHUB=""

# ---------- 役割 ----------
ISU_NGINX_HOST=isu1          # アクセスログ(alp)を取るホスト
ISU_DB_HOST=isu1             # slow log を取るホスト。インメモリ化で DB を捨てたら空にする
ISU_APP_HOSTS="isu1"         # アプリを置くホスト（perf / journal を取る）
ISU_LOCK_HOST=isu1           # デプロイ/ベンチのロックを置くホスト
# deploy 後に restart するサービス（ホストごと）。nginx は reload、mysql は設定変更時のみ restart。
ISU_SERVICES_isu1=""
ISU_SERVICES_isu2=""
ISU_SERVICES_isu3=""

# ---------- アプリ / ビルド ----------
ISU_ARCH=amd64               # amd64 | arm64（isu-setup が自動で書き換える）
ISU_LANG=go                  # go | rust | none
ISU_SRC_DIR=""
ISU_BIN_NAME=""
ISU_REMOTE_BIN=""
# バイナリ以外にアプリホストへ送る repo 内パス（/home/isucon/ 以下に同じ相対パスで置く）
ISU_DEPLOY_PATHS=""
# isu-import でサーバから取り込むパス（/home/isucon からの相対）
ISU_IMPORT_PATHS="webapp env.sh"
# 取り込まないもの（他言語の実装・ビルド成果物）
ISU_IMPORT_EXCLUDE="webapp/nodejs webapp/perl webapp/php webapp/python webapp/ruby webapp/rust/target node_modules vendor .git *.log"

# ---------- 計測 ----------
ISU_ACCESS_LOG=/var/log/nginx/access.log
ISU_SLOW_LOG=/var/log/mysql/isu-slow.log
ISU_DB_NAME=""
ISU_PPROF_URL=""             # Go: http://127.0.0.1:6060/debug/pprof/profile （空なら perf のみ）
ISU_IDLE_RPS=5               # 秒ごとの件数がこの値を超えた区間をログから算出する
ISU_IDLE_SECS=10

# ---------- 動作確認 ----------
ISU_TARGET_HOST=""
ISU_HEALTH_PATH=/
ISU_INIT_PATH=""
ISU_INIT_ARGS=""                         # 初期化 API に渡す curl 引数（ボディが要る場合）
ISU_GOLDEN_JQ='.'                        # golden の正規化（毎回変わる値を消す jq フィルタ）

# ---------- ベンチ ----------
# 本番はポータルから実行するので空。練習環境ではベンチコマンドを入れると自動で回る。
ISU_BENCH_HOST=""
ISU_BENCH_CMD=""
ISU_SCORE_REGEX=""           # 例: 'スコア=([0-9]+)'

# DB の種類。DB を使わなければ none。docker の例: ISU_DB_CMD="sudo docker exec db"
ISU_DB_KIND=""
ISU_DB_CMD="sudo"
ISU_DB_PATH=""              # sqlite の DB ファイル
ISU_REMOTE_HOME=/home/isucon
ISU_TARGET_SCHEME=""        # http | https
ISU_TARGET_PORT=""          # 80 | 443 | その他の入口ポート
ISU_APP_PORT=""             # 平文 HTTP の待ち受け。capture で使う
ISU_PORTAL_URL=""
# ISO 8601、タイムゾーン付き。docs/RULES.md の終盤の時刻表と揃える。
ISU_END_AT=""
ISU_FREEZE_AT=""

ISU_DB_RESTART_CMD=""       # 通常は自動。docker exec のオプションがある場合は明示する

ISU_CAPTURE_MB=1024          # 先頭を残して停止するサイズ上限（MiB）
ISU_CAPTURE_SECS=300         # capture の時間上限
