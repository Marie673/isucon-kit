#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///
"""終盤の時刻表から区切りを通知する。"""
import argparse
import datetime
import json
import os
from pathlib import Path
import subprocess
import sys
import time


def schedule(start, end=None):
    due = [(start + 1800, 'design', '制約と最初の計測から docs/design.md の骨格を書く。'),
           (start + 3600, 'audit', '見たもの → 考え → 決めたことを根拠と突き合わせる。')]
    if end is not None:
        due += [(end - 7200, 'review', '前提を見直し、試験中のフラグを片付ける。'),
                (end - 3600, 'reboot', '再起動試験と直後のベンチを確認する。'),
                (end - 1800, 'final', 'docs/RULES.md の時刻表で凍結を確認する。最終ベンチは tools/stop-rule/stop-rule で決める。')]
    return sorted(due)


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('command', choices=['start', 'status', 'hook'], default='hook', nargs='?')
    p.add_argument('at', nargs='?'); p.add_argument('--end-at')
    a = p.parse_args()
    try:
        root = Path(subprocess.check_output(['git', 'rev-parse', '--show-toplevel'], text=True).strip())
        gd = Path(subprocess.check_output(['git', 'rev-parse', '--absolute-git-dir'], text=True).strip())
    except subprocess.CalledProcessError:
        return 0
    state = gd / 'checkpoint.json'
    if a.command == 'start':
        start = time.time()
        if a.at:
            start = datetime.datetime.fromisoformat(datetime.date.today().isoformat() + 'T' + a.at).timestamp()
        end = a.end_at or os.environ.get('ISU_END_AT')
        if not end and (root / 'isu.env').exists():
            end = subprocess.check_output(['bash', '-c', 'source "$1"; printf %s "$ISU_END_AT"', 'bash', str(root / 'isu.env')], text=True).strip()
        end = datetime.datetime.fromisoformat(end.replace('Z', '+00:00')).timestamp() if end else None
        state.write_text(json.dumps({'schedule': schedule(start, end), 'fired': []}))
        print('checkpoint: 開始を記録しました'); return 0
    if a.command == 'hook':
        sys.stdin.read()
    if not state.exists():
        return 0
    data = json.loads(state.read_text()); messages = []
    for due, id, message in data['schedule']:
        if a.command == 'status':
            print(datetime.datetime.fromtimestamp(due).isoformat(), id, '済' if id in data['fired'] else '未')
        elif due <= time.time() and id not in data['fired']:
            data['fired'].append(id); messages.append('[checkpoint ' + id + '] ' + message)
    if a.command == 'hook':
        # 作戦ボードの最終コミット以後に3本あれば一度だけ促す。
        raw = subprocess.check_output(['git', 'log', '-1', '--format=%ct', '--', 'docs/README.md'], text=True).strip()
        since = int(raw or 0)
        n = sum(p.stat().st_mtime > since for p in (root / 'results').glob('*/meta.env'))
        key = 'stale-' + str(since)
        if n >= 3 and key not in data['fired']:
            data['fired'].append(key)
            messages.append('作戦ボードの判断の数字を直す。効く項・取りこぼし・今のボトルネック・撤回の条件を確かめる。')
        state.write_text(json.dumps(data))
        if messages:
            print(json.dumps({'hookSpecificOutput': {'hookEventName': 'PostToolUse', 'additionalContext': '\n'.join(messages)}}, ensure_ascii=False))
    return 0

if __name__ == '__main__':
    sys.exit(main())
