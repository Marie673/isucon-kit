# lab-aws の設定の雛形。.env にコピーして埋める（.env はコミットしない）。
# 空のままの LAB_MAX_INSTANCES / LAB_KEY_NAME / LAB_SG_ID は、未承認の間の安全装置（up が動かない）。

# AWS（例: プロファイル my-profile、リージョン ap-northeast-1。固定の既定値は持たない）
AWS_PROFILE=
AWS_REGION=

# 人間が承認した範囲
LAB_MAX_INSTANCES=
# LAB_MAX_TTL_MIN=240
# LAB_ALLOWED_FAMILIES=c5,c5n,c6i,c6a,c7i,c7a,m5,m6i,m7i

# 作業者が事前に用意するもの（この道具は作らない）
LAB_KEY_NAME=
LAB_SSH_KEY=
LAB_SG_ID=
# LAB_SUBNET_ID=
# LAB_SSH_USER=ubuntu
# LAB_HOST_FIELD=public

# 任意
# LAB_SPOT=1
# LAB_VOLUME_GB=30
# LAB_AMI=
# LAB_UBUNTU_VERSION=24.04
# LAB_ROOT_DEVICE=/dev/sda1
# LAB_USER_DATA_FILE=
# LAB_STATE_DIR=.cache/lab-aws
