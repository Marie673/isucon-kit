#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///
from isu_runtime import Kit
import sys
import time
try:
    k = Kit()
    while True:
        k.guard_time()
        for h in k.hosts():
            print(h, k.ssh(h, 'LC_ALL=C vmstat -n -t 1 2').stdout, flush=True)
        print('lock:', k.owner() or 'free', flush=True)
        time.sleep(5)
except (RuntimeError, KeyboardInterrupt) as e:
    print(str(e), file=sys.stderr)
