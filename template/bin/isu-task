#!/usr/bin/env bash
# isu-task <dot の引数...> — タスクボード（dots）。どの worktree から叩いてもメインチェックアウトの .dots/ を使う
#   isu-task ready                     着手可能なタスク
#   isu-task add "N+1 解消: GET /api/x" -p 1 -d "根拠: results/<id> で sum 1位。触るパス: webapp/go/x.go"
#   isu-task on <id>                   着手宣言（他の人・エージェントに見える）
#   isu-task off <id> -r "+1200 (results/<id>)"   完了。外れも理由付きで閉じる
# 変更系のコマンドは .dots/ だけを自動コミットする。
. "$(dirname "$0")/lib.sh"
command -v dot >/dev/null || die "dot がありません（isucon-kit の setup/mac.sh）"
[ -d "$ISU_MAIN/.dots" ] || (cd "$ISU_MAIN" && dot init >/dev/null)
(cd "$ISU_MAIN" && dot "$@")
case "${1:-}" in
  ""|ls|list|ready|show|find|tree) ;;
  *) isu_commit_shared "task: $*" .dots ;;
esac
