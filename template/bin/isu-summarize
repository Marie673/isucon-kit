#!/usr/bin/env bash
# isu-summarize <id> — results/<id>/ の生データから SUMMARY.md を作る（エージェントはまずこれを読む）
. "$(dirname "$0")/lib.sh"
id=${1:?usage: isu-summarize <id>}
R="$ISU_RESULTS/$id"; [ -f "$R/meta.env" ] || die "no such result: $id"
START="" END="" START_HMS="" END_HMS="" SCORE="" NOTE="" SHA="" BRANCH="" WHO=""
# shellcheck disable=SC1091
. "$R/meta.env"

code() { printf '\n```\n'; cat; printf '```\n'; }
{
  echo "# Bench $id"
  echo
  echo "| score | commit | branch | who | window | note |"
  echo "|---|---|---|---|---|---|"
  echo "| ${SCORE:-未記録 → \`bin/isu-score $id <score>\`} | $SHA | $BRANCH | $WHO | ${START_HMS:-?}–${END_HMS:-?} | $NOTE |"

  if [ -f "$R/$ISU_NGINX_HOST/alp.txt" ]; then
    echo; echo "## エンドポイント（alp・合計時間順の上位25）"
    head -n 29 "$R/$ISU_NGINX_HOST/alp.txt" | code
    if [ -s "$R/$ISU_NGINX_HOST/alp-errors.txt" ]; then
      echo; echo "## 4xx / 5xx（件数順）"
      head -n 15 "$R/$ISU_NGINX_HOST/alp-errors.txt" | code
    fi
  fi

  # 山の窓（isucon-kit の tools/bench-window があるとき）。走行全体の平均では、最後の数十秒の詰まりが見えない
  bw="$ISU_ROOT/tools/bench-window/bench-window"
  if [ -x "$bw" ]; then
    logs=(); cpus=()
    for h in $ISU_HOSTS; do
      [ -s "$R/$h/access.log" ] && logs+=("$h=$R/$h/access.log")
      [ -s "$R/$h/pidstat.log" ] && cpus+=(--cpu "$h=$R/$h/pidstat.log")
    done
    if [ ${#logs[@]} -gt 0 ]; then
      grp=(); [ -f "$ISU_ROOT/conf/alp-groups.txt" ] && grp=(--group "$ISU_ROOT/conf/alp-groups.txt")
      echo; echo "## 山の窓（最後 ${ISU_WINDOW_LAST:-30s}。tools/bench-window。窓を変えるなら --anchor で直接流す）"
      "$bw" "${logs[@]}" --last "${ISU_WINDOW_LAST:-30s}" ${grp[@]+"${grp[@]}"} ${cpus[@]+"${cpus[@]}"} --top 15 2>&1 | sed '1d; s/^## /### /' \
        || echo "（bench-window が失敗しました）"
    fi
  fi

  if [ -n "$ISU_DB_HOST" ] && [ -f "$R/$ISU_DB_HOST/slow.txt" ]; then
    echo; echo "## スロークエリ（pt-query-digest の Profile。詳細は $ISU_DB_HOST/slow.txt）"
    awk '/^# Profile/{p=1} p&&/^$/{exit} p' "$R/$ISU_DB_HOST/slow.txt" | code
  fi

  echo; echo "## CPU（ベンチ中の平均 %）"
  echo
  echo "| host | us | sy | wa | idle | max run queue | samples |"
  echo "|---|---|---|---|---|---|---|"
  for h in $ISU_HOSTS; do
    [ -f "$R/$h/vmstat.log" ] || continue
    awk -v host="$h" -v s="$START_HMS" -v e="$END_HMS" '
      $1=="r" { for (i=1;i<=NF;i++) col[$i]=i; next }
      $1 !~ /^[0-9]+$/ { next }
      { t=$NF; if (s!="" && e!="" && (t<s || t>e)) next
        n++; us+=$col["us"]; sy+=$col["sy"]; wa+=$col["wa"]; id+=$col["id"]; if ($col["r"]>mr) mr=$col["r"] }
      END { if (n) printf "| %s | %.0f | %.0f | %.0f | %.0f | %d | %d |\n", host, us/n, sy/n, wa/n, id/n, mr, n }' "$R/$h/vmstat.log"
  done

  echo; echo "## プロセス別 CPU（pidstat・ベンチ中の平均 %CPU。100 = 1コア）"
  for h in $ISU_HOSTS; do
    [ -f "$R/$h/pidstat.log" ] || continue
    echo; echo "**$h**"
    awk -v s="$START_HMS" -v e="$END_HMS" '
      /^#/ { for (i=2;i<=NF;i++) { if ($i=="%CPU") c=i-1; if ($i=="Command") m=i-1 }; next }
      $1 ~ /^[0-9][0-9]:/ && c { if (s!="" && e!="" && ($1<s || $1>e)) next; secs[$1]=1; cpu[$m]+=$c }
      END { n=0; for (k in secs) n++; for (p in cpu) printf "%-20s %6.1f\n", p, cpu[p]/(n?n:1) }' "$R/$h/pidstat.log" \
      | sort -k2 -nr | head -8 | code
  done

  for h in $ISU_APP_HOSTS; do
    if [ -s "$R/$h/perf.txt" ]; then
      echo; echo "## perf（${h}・CPU サンプル上位40。comm / dso / symbol）"
      head -n 40 "$R/$h/perf.txt" | code
    fi
    if [ -s "$R/$h/journal.txt" ]; then
      echo; echo "## アプリログ（${h}・error/warn 系。件数 メッセージ）"
      head -n 20 "$R/$h/journal.txt" | cut -c1-240 | code
    fi
  done
  [ -f "$R/bench.log" ] && { echo; echo "## ベンチ出力（末尾）"; tail -n 15 "$R/bench.log" | cut -c1-240 | code; }

  echo; echo "## 生データ"; echo
  (cd "$R" && find . -type f ! -name SUMMARY.md | sort | sed 's|^\./|- |')
} > "$R/SUMMARY.md"
