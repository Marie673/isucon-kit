#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///
"""終盤の時刻表から区切りを通知する。"""
import argparse
import datetime
import json
import os
from pathlib import Path
import subprocess
import sys
import time


def schedule(start, end=None):
    due = [(start + 1800, 'design', '0 ベースの設計の骨格はあるか。制約と最初のベンチの数字から、`docs/design.md` の D6 に「制約に最も合う形」を書いたか。継ぎ足しを選ぶなら、継ぎ足しのままボトルネックを取り除ける計算を DECISIONS.md に書いたか。却下の理由は回避の形を挙げて突き合わせたか。まだなら今やる。'),
           (start + 2700, 'cpu3', 'プロファイルからサーバーごとの CPU の上位の処理を出し、それぞれに (1) 前もって計算できるか (2) 同じ入力の結果を覚えられるか (3) CPU の機能の合うサーバーに移せるか、を当ててボトルネック表に載せる。'),
           (start + 3600, 'audit1', '監査: subagent を 1 本出し、skill audit の項目を、DECISIONS.md・ボトルネック表・experiments.md・results/ と突き合わせさせる（読み取りだけ、20 分以内、結論と出典だけを返させる）。返ってきた指摘で、判断を崩す情報があれば判断を出し直す。待たずに今の仕事を続ける。'),
           (start + 10800, 'audit2', '監査: skill audit で 2 回目の監査の subagent を出す（読み取りだけ）。スコアが 30 分以上更新されていなければ、スコアの帳簿とスコアの式の項を数え直してから次の手を選ぶ。')]
    if end is not None:
        due += [(end - 10800, 'review', '前提の見直し: 作戦ボードを直し、design.md の D の却下した案の前提が今も成り立つかを数字で確かめる。skill audit で 3 回目の監査の subagent も出す。試験中のフラグを片付ける。'),
                (end - 7200, 'reboot', '再起動試験: 全サーバーを同時に再起動し、手作業なしで上がること・書いたデータが残ること・直後のベンチが pass することを確かめる（版が固まっていれば前倒し済みでよい）。'),
                (end - 3600, 'final', '終盤: 作戦ボードを直す。凍結は docs/RULES.md の時刻表の時刻に行い、前倒ししない。凍結の後は待機せず、ブランチで差を詰める。最終ベンチは tools/stop-rule/stop-rule で止める（同じ版のスコアの一覧と、締め切りまでに流せる本数から閾値を出す）。')]
    return sorted(due)


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('command', choices=['start', 'status', 'hook'], default='hook', nargs='?')
    p.add_argument('at', nargs='?'); p.add_argument('--end-at')
    a = p.parse_args()
    try:
        root = Path(subprocess.check_output(['git', 'rev-parse', '--show-toplevel'], text=True).strip())
        gd = Path(subprocess.check_output(['git', 'rev-parse', '--absolute-git-dir'], text=True).strip())
    except subprocess.CalledProcessError:
        return 0
    state = gd / 'checkpoint.json'
    if a.command == 'start':
        start = time.time()
        if a.at:
            start = datetime.datetime.fromisoformat(datetime.date.today().isoformat() + 'T' + a.at).timestamp()
        end = a.end_at or os.environ.get('ISU_END_AT')
        if not end and (root / 'isu.env').exists():
            end = subprocess.check_output(['bash', '-c', 'source "$1"; printf %s "$ISU_END_AT"', 'bash', str(root / 'isu.env')], text=True).strip()
        end = datetime.datetime.fromisoformat(end.replace('Z', '+00:00')).timestamp() if end else None
        state.write_text(json.dumps({'schedule': schedule(start, end), 'fired': []}))
        print('checkpoint: 開始を記録しました'); return 0
    if a.command == 'hook':
        sys.stdin.read()
    if not state.exists():
        return 0
    data = json.loads(state.read_text()); messages = []
    for due, id, message in data['schedule']:
        if a.command == 'status':
            print(datetime.datetime.fromtimestamp(due).isoformat(), id, '済' if id in data['fired'] else '未')
        elif due <= time.time() and id not in data['fired']:
            data['fired'].append(id); messages.append('[checkpoint ' + id + '] ' + message)
    if a.command == 'hook':
        # 作戦ボードの最終コミット以後に3本あれば一度だけ促す。
        raw = subprocess.check_output(['git', 'log', '-1', '--format=%ct', '--', 'docs/README.md'], text=True).strip()
        since = int(raw or 0)
        n = sum(p.stat().st_mtime > since for p in (root / 'results').glob('*/meta.env'))
        key = 'stale-' + str(since)
        if n >= 3 and key not in data['fired']:
            data['fired'].append(key)
            messages.append('[checkpoint stale] 作戦ボードの判断の数字を最後に直してから、ベンチが ' + str(n) + ' 本流れた。表（点・点の式の項・取りこぼし・今のボトルネック・撤回の条件）を直してから次の手を選ぶ。撤回の条件を満たしていたら判断を出し直す。効く項を止めているものをボトルネックに選ぶ（skill audit の 3・7c）。')
        state.write_text(json.dumps(data))
        if messages:
            print(json.dumps({'hookSpecificOutput': {'hookEventName': 'PostToolUse', 'additionalContext': '\n'.join(messages)}}, ensure_ascii=False))
    return 0

if __name__ == '__main__':
    sys.exit(main())
